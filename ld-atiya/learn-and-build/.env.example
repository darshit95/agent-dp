# LLM Gateway - see DECISIONS.md ADR-003 and src/llm/gateway.py
#
# Both providers are free-tier. The gateway never falls back to a paid
# tier automatically (REQUIREMENTS.md "Cost Protection Strategy") - if
# both of these are exhausted or missing, generate() raises
# AllProvidersFailedError instead of silently spending money.

# Primary provider (Gemini 3.6 Flash, ~1500 req/day free)
GEMINI_API_KEY=

# Fallback provider (Groq, 30 req/min free) - used only when Gemini is
# rate-limited, erroring, or its circuit breaker is open
GROQ_API_KEY=

# Optional tuning (defaults shown) - see src/llm/config.py
# ATIYA_GEMINI_MODEL=gemini/gemini-3.6-flash
# ATIYA_GROQ_MODEL=groq/llama-3.3-70b-versatile
# ATIYA_LLM_TIMEOUT_S=30.0
# ATIYA_LLM_MAX_RETRIES=3
# ATIYA_LLM_BACKOFF_BASE_S=0.5
# ATIYA_LLM_BACKOFF_MAX_S=8.0
# ATIYA_LLM_CIRCUIT_FAILURE_THRESHOLD=5
# ATIYA_LLM_CIRCUIT_RESET_TIMEOUT_S=60.0
